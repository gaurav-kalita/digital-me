SECRET_KEY=your-secret-key
LLM_API_KEY=your-llm-key
VECTOR_DB_URL=your-vector-db-url
VECTOR_STORE_TYPE=faiss

LLM_TYPE=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma:3b
DATA_DIR=../data
INDEX_ARTIFACT_PATH=../data/.index/chunks.json
FAISS_INDEX_PATH=../data/.index/chunks.faiss
FAISS_METADATA_PATH=../data/.index/chunks.metadata.json
CLEANER_TYPE=conservative
EMBEDDER_TYPE=auto
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=256
CHUNKER_TYPE=tiktoken
CHUNKER_ENCODING_NAME=cl100k_base
CHUNKER_HF_MODEL_NAME=bert-base-uncased
CHUNK_SIZE_TOKENS=240
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=8
RETRIEVAL_DENSE_WEIGHT=0.65
RETRIEVAL_SPARSE_WEIGHT=0.35
RERANKER_ENABLED=true
RERANKER_TOP_K=5
CONTEXT_MAX_CHUNKS=5
CONTEXT_MAX_TOKENS=900
