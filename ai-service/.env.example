SERVICE_NAME=digital-me-ai-service
SERVICE_VERSION=2.0.0
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
SECRET_KEY=your-secret-key
LLM_API_KEY=your-llm-key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gemma3:1b
VECTOR_DB_URL=your-vector-db-url
VECTOR_STORE_TYPE=faiss
REDIS_CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_NAMESPACE=digital-me
CACHE_TTL_SECONDS=3600
RETRIEVAL_CACHE_TTL_SECONDS=3600

LLM_TYPE=ollama
OLLAMA_URL=http://localhost:11434
OPENAI_MODEL=gemma3:1b
DATA_DIR=../data
INDEX_ARTIFACT_PATH=../data/.index/chunks.json
FAISS_INDEX_PATH=../data/.index/chunks.faiss
FAISS_METADATA_PATH=../data/.index/chunks.metadata.json
CLEANER_TYPE=conservative
EMBEDDER_TYPE=auto
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=256
EMBEDDING_LOCAL_FILES_ONLY=true
CHUNKER_TYPE=tiktoken
CHUNKER_ENCODING_NAME=cl100k_base
CHUNKER_HF_MODEL_NAME=bert-base-uncased
CHUNK_SIZE_TOKENS=240
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=8
RETRIEVAL_DENSE_WEIGHT=0.65
RETRIEVAL_SPARSE_WEIGHT=0.35
INGESTION_LOADER_STRATEGY=llamaindex
RETRIEVAL_BACKEND=llamaindex
GUARDRAIL_ENABLED=false
GUARDRAIL_MAX_QUESTION_LENGTH=512
GUARDRAIL_REPEATED_TOKEN_RATIO=0.6
GUARDRAIL_ALLOWED_QUESTION_PATTERNS=who are you,tell me about yourself,about you,about me,my past,my history,notice period,availability,current availability,what is your experience,what is my experience,what have you worked on,what have you built,what are your skills,what are your projects,what recent project have you worked on,what recent projects have you worked on,what is your recent project,what is your latest project,what are your characteristics,what are your qualities,what are your strengths,where have you worked,which companies have you worked at,what technologies have you used,what is your background,what is your career history,what roles have you held,what are your achievements,what is your tech stack,what do you do,what do you work on,tell me about my past
GUARDRAIL_BLOCKED_PATTERNS=ignore previous instructions,reveal system prompt,show system prompt,developer mode,bypass safety,api key,secret key,hidden prompt
GUARDRAIL_OUTPUT_BLOCKED_PATTERNS=system prompt,developer message,hidden prompt,api key,secret key
GUARDRAIL_REFUSAL_MESSAGE=I can only answer questions about Gaurav Kalita, his work, skills, projects, and background.
RERANKER_ENABLED=true
RERANKER_STRATEGY=semantic
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_CANDIDATES=20
RERANKER_BATCH_SIZE=8
RERANKER_TOP_K=5
CONTEXT_MAX_CHUNKS=5
CONTEXT_MAX_TOKENS=900
